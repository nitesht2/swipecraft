# Copy to .env.local and fill in what you need. Restart the dev server after editing.
# .env.local is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# AI generation
# ---------------------------------------------------------------------------
# Slide + hook generation. OpenRouter is tried first, Anthropic is the fallback.
# Leave both blank to run in bring-your-own-key mode, where each visitor supplies
# their own key through the in-app Keys panel.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Defaults to x-ai/grok-4.3.
OPENROUTER_MODEL=

# AI slide images (gpt-image-1). This is the most expensive route per call.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Public deployments
# ---------------------------------------------------------------------------
# Set to 1 on anything reachable from the internet. Server keys above are then
# ignored entirely and every request must carry the caller's own key, so there
# is no shared budget for a stranger to drain.
BYOK_ONLY=

# ---------------------------------------------------------------------------
# Scheduling (local only)
# ---------------------------------------------------------------------------
# /api/post publishes to YOUR connected social accounts. Leave this unset on any
# public deployment or strangers can post as you. Requires the postiz CLI on PATH
# (npm i -g postiz) and a connected channel.
ENABLE_POSTIZ=
POSTIZ_API_KEY=

# Optional. Path to the postiz binary if it is not on PATH.
POSTIZ_BIN=

# ---------------------------------------------------------------------------
# MCP inbox (local only)
# ---------------------------------------------------------------------------
# Lets the app import carousels written by mcp/swipecraft-mcp.mjs. Reads a
# directory on the host machine, so leave this unset on any shared deployment.
ENABLE_MCP_INBOX=
# Optional. Defaults to ~/.swipecraft/inbox
SWIPECRAFT_INBOX=

# ---------------------------------------------------------------------------
# Brand
# ---------------------------------------------------------------------------
# The footer on every slide and the handle stamped on CTA slides. NEXT_PUBLIC_
# values are inlined into the client bundle at build time, so no secrets here.
# Unset falls back to neutral placeholders.
NEXT_PUBLIC_BRAND_NAME=
NEXT_PUBLIC_BRAND_HANDLE=
NEXT_PUBLIC_BRAND_TAGLINE=
NEXT_PUBLIC_BRAND_LOGO=
NEXT_PUBLIC_BRAND_SHOW_FOOTER=
NEXT_PUBLIC_BRAND_SHOW_PAGE_NUMBERS=

# ---------------------------------------------------------------------------
# Brand voices
# ---------------------------------------------------------------------------
# Absolute path to a JSON file overriding the built-in voices, so your own
# brand voice stays out of the repo. Keys: shortform, professional, builder.
# Each may set "handle" and "guide". Read server-side only.
#
#   { "builder": { "handle": "@yourhandle", "guide": "Who is speaking..." } }
#
# Missing or malformed file logs a warning and uses the built-in voices.
SWIPECRAFT_VOICES=
