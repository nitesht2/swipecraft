# Copy to .env.local and fill in what you need. Restart the dev server after editing.
# .env.local is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# AI generation
# ---------------------------------------------------------------------------
# Slide + hook generation. OpenRouter is tried first, Anthropic is the fallback.
# Leave both blank to run in bring-your-own-key mode, where each visitor supplies
# their own key through the in-app Keys panel.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Optional. Defaults to x-ai/grok-4.3.
OPENROUTER_MODEL=

# AI slide images (gpt-image-1). This is the most expensive route per call.
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Public deployments
# ---------------------------------------------------------------------------
# Set to 1 on anything reachable from the internet. Server keys above are then
# ignored entirely and every request must carry the caller's own key, so there
# is no shared budget for a stranger to drain.
BYOK_ONLY=

# ---------------------------------------------------------------------------
# Scheduling (local only)
# ---------------------------------------------------------------------------
# /api/post publishes to YOUR connected social accounts. Leave this unset on any
# public deployment or strangers can post as you. Requires the postiz CLI on PATH
# (npm i -g postiz) and a connected channel.
ENABLE_POSTIZ=
POSTIZ_API_KEY=

# Optional. Path to the postiz binary if it is not on PATH.
POSTIZ_BIN=
